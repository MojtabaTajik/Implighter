{
  "manifest_version": 3,
  "name": "implighter",
  "short_name": "implighter",
  "version": "1.0.0",
  "description": "Highlight what matters for your goal, dim the rest, and summarize pages or YouTube videos with AI.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "commands": {
    "run-highlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Highlight this page for your last goal"
    },
    "run-summarize": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Summarize this page"
    }
  },
  "background": {
    "service_worker": "src/entrypoints/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "implighter",
    "default_popup": "src/entrypoints/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/entrypoints/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/features/*",
        "src/shared/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
