{
  "manifest_version": 3,
  "name": "Important Highlighter (implighter)",
  "version": "0.1.0",
  "description": "Give it a goal, and it dims the noise on the page while highlighting what actually matters.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "src/entrypoints/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "implighter",
    "default_popup": "src/entrypoints/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/entrypoints/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/entrypoints/content.js"],
      "css": ["src/features/highlight/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/features/*", "src/shared/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
